{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/herdr-ticket-dispatcher/worker-result.schema.json",
  "title": "Herdr ticket worker result",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "head_sha", "acceptance", "tests"],
      "properties": {
        "status": {"const": "completed"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "acceptance": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["criterion", "met", "evidence"],
            "properties": {
              "criterion": {"type": "string", "minLength": 1},
              "met": {"const": true},
              "evidence": {"type": "string", "minLength": 1}
            }
          }
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "exit_code", "summary"],
            "properties": {
              "command": {"type": "string", "minLength": 1},
              "exit_code": {"type": "integer"},
              "summary": {"type": "string", "minLength": 1}
            }
          }
        },
        "notes": {"type": "string"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"enum": ["failed", "needs-input"]},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  ]
}
