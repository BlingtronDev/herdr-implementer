{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/herdr-ticket-dispatcher/run-state.schema.json",
  "title": "Herdr ticket batch executor run state",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "run_id", "batch_number", "batch_tickets", "slug", "repo_root", "git_common_dir", "target_branch", "base_head", "protected_status", "kind", "provider", "model", "thinking", "jobs", "fail_fast", "context_window", "phase", "tickets", "created_at", "updated_at"],
  "properties": {
    "version": {"const": 4},
    "run_id": {"type": "string", "minLength": 1},
    "batch_number": {"type": "integer", "minimum": 1},
    "batch_tickets": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9]{2}[a-z]?$"}, "uniqueItems": true},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "repo_root": {"type": "string"},
    "git_common_dir": {"type": "string"},
    "target_branch": {"type": "string", "minLength": 1},
    "base_head": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "protected_status": {"type": "string", "description": "Porcelain status outside .scratch/<slug>/ captured before batch execution"},
    "kind": {"enum": ["opencode", "codex", "pi"]},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "thinking": {"enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"]},
    "jobs": {"type": "integer", "minimum": 1},
    "fail_fast": {"type": "boolean"},
    "context_window": {"type": ["integer", "null"], "minimum": 1},
    "batch_timeout_minutes": {"type": ["integer", "null"], "minimum": 120},
    "phase": {"enum": ["preflight", "running", "stopping", "completed", "failed", "stalled"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "tickets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["path", "status", "attempts"],
        "properties": {
          "path": {"type": "string"},
          "status": {"enum": ["ready-for-agent", "claimed", "completed", "failed", "skipped"]},
          "attempts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["attempt", "state", "agent", "provider", "model", "thinking", "tab", "pane", "branch", "worktree", "ticket_base_sha", "result_path", "handoff_dir", "rollover_count", "handoffs"],
              "properties": {
                "attempt": {"type": "integer", "minimum": 1},
                "state": {"enum": ["allocating", "prompting", "running", "handing-off", "stopping", "completed", "failed", "abandoned", "needs-input"]},
                "agent": {"type": "string"},
                "provider": {"type": "string", "minLength": 1},
                "model": {"type": "string", "minLength": 1},
                "thinking": {"enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"]},
                "tab": {"type": "string"},
                "pane": {"type": "string"},
                "context_ref": {"type": "string"},
                "context_window": {"type": ["integer", "null"], "minimum": 1},
                "branch": {"type": "string"},
                "worktree": {"type": "string"},
                "ticket_base_sha": {"type": "string"},
                "result_path": {"type": "string"},
                "handoff_dir": {"type": "string"},
                "rollover_count": {"type": "integer", "minimum": 0},
                "handoffs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["sequence", "path", "reason", "sample", "requested_at", "agent", "tab", "pane", "context_ref", "continued_by", "continued_at"],
                    "properties": {
                      "sequence": {"type": "integer", "minimum": 1},
                      "path": {"type": "string"},
                      "reason": {"type": "string"},
                      "sample": {"type": "object"},
                      "requested_at": {"type": "string", "format": "date-time"},
                      "correction_sent": {"type": "boolean"},
                      "agent": {"type": "string"},
                      "tab": {"type": "string"},
                      "pane": {"type": "string"},
                      "context_ref": {"type": "string"},
                      "continued_by": {"type": "string"},
                      "continued_at": {"type": "string", "format": "date-time"}
                    }
                  }
                },
                "pending_handoff": {"type": "object"},
                "watcher_pid": {"type": "integer"},
                "context_snapshot": {"type": "object"},
                "reason": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
