#!/usr/bin/env python3
"""Deterministic fake of the Herdr CLI for implementer tests.

Behavior is driven by files under $HI_FAKE_DIR:
- agents/<name>.json          agent state: status, kind, pane, prompt_count
- panes.json                  registered tabs/panes (tab create/close, pane list)
- tab_close_fail              tab ids (or *) whose `tab close` fails
- agent_get_error             agent names whose `agent get` fails transiently
- agent_get_missing           agent names whose `agent get` reports not_found
- agent_list_working          agent names forced to `working` in `agent list`
- pane_list_malformed         pane list mode: missing-tab | element-not-object |
                              result-not-object | empty-pane-id | empty-tab-id |
                              conflicting-tab
- agent_list_malformed        agent list mode: missing-tab | result-not-object |
                              empty-pane-id | empty-tab-id
- release_race_foreign        inject a pane during the exit key press
- release_race_dirty          write a file during the exit key press
- release_race_close_foreign   tab ids that gain a pane while my tab closes
- start_failures              remaining transient agent_pane_busy failures
- prompt_uncertain            delete-on-use marker: first prompt returns an error
                              after being accepted server-side
- HI_FAKE_SCENARIO           script spawned on the first successful prompt
"""

import json
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(os.environ["HI_FAKE_DIR"])
(ROOT / "agents").mkdir(parents=True, exist_ok=True)
LOG = ROOT / "herdr.log.jsonl"
PANES = ROOT / "panes.json"


def read_panes():
    try:
        return json.loads(PANES.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return []


def write_panes(panes):
    tmp = PANES.with_suffix(".tmp")
    tmp.write_text(json.dumps(panes), encoding="utf-8")
    os.replace(tmp, PANES)


def record(value):
    with LOG.open("a", encoding="utf-8") as stream:
        stream.write(json.dumps(value) + "\n")


def emit(value, code=0):
    print(json.dumps(value))
    sys.exit(code)


def fail(code, message="", exit_code=1):
    print(json.dumps({"error": {"code": code, "message": message}}))
    sys.exit(exit_code)


def agent_file(name):
    return ROOT / "agents" / f"{name}.json"


def read_agent(name):
    try:
        return json.loads(agent_file(name).read_text(encoding="utf-8"))
    except FileNotFoundError:
        return None


def write_agent(name, data):
    path = agent_file(name)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(data), encoding="utf-8")
    os.replace(tmp, path)


def as_agent(name, data):
    value = {
        "name": name,
        "agent": data.get("kind", "pi"),
        "agent_status": data.get("status", "idle"),
        "pane_id": data.get("pane", ""),
        "tab_id": data.get("tab", ""),
        "interactive_ready": True,
    }
    if data.get("session"):
        kind = data.get("kind", "pi")
        value["agent_session"] = {
            "agent": kind,
            "kind": "id" if kind == "opencode" else "path",
            "source": f"herdr:{kind}",
            "value": data["session"],
        }
    return value


def main(argv):
    record({"argv": argv})
    if argv[:2] == ["tab", "create"]:
        counter = ROOT / "tab_counter"
        number = int(counter.read_text()) + 1 if counter.is_file() else 1
        counter.write_text(str(number))
        tab_id = f"ft:t{number}"
        pane_id = f"fp:p{number}"
        cwd = ""
        if "--cwd" in argv:
            cwd = argv[argv.index("--cwd") + 1]
        panes = read_panes()
        panes.append({"pane_id": pane_id, "tab_id": tab_id, "cwd": cwd})
        write_panes(panes)
        emit({"result": {"tab": {"tab_id": tab_id}, "root_pane": {"pane_id": pane_id}}})
    if argv[:2] == ["tab", "close"]:
        tab = argv[2] if len(argv) > 2 else ""
        marker = ROOT / "tab_close_fail"
        targets = marker.read_text(encoding="utf-8").split() if marker.is_file() else []
        if "*" in targets or tab in targets:
            fail("tab_close_failed", f"simulated close failure for {tab}")
        # An unrelated tab can gain a foreign pane while this tab's close is
        # being processed; the release path must recheck before each close.
        race = ROOT / "release_race_close_foreign"
        race_targets = race.read_text(encoding="utf-8").split() if race.is_file() else []
        if race_targets:
            panes = read_panes()
            present = {pane.get("tab_id") for pane in panes}
            appended = False
            for target in race_targets:
                if target and target != tab and target in present:
                    panes.append({"pane_id": f"fp:race{len(panes)}", "tab_id": target, "cwd": ""})
                    appended = True
            if appended:
                write_panes(panes)
        panes = read_panes()
        remaining = [pane for pane in panes if pane.get("tab_id") != tab]
        if len(remaining) == len(panes):
            fail("tab_not_found", f"no tab {tab}")
        write_panes(remaining)
        emit({"result": {"closed": tab}})
    if argv[:2] == ["pane", "list"]:
        malformed = ROOT / "pane_list_malformed"
        if malformed.is_file():
            mode = malformed.read_text(encoding="utf-8").strip() or "missing-tab"
            if mode == "result-not-object":
                emit({"result": ["not", "an", "object"]})
            if mode == "element-not-object":
                emit({"result": {"panes": [{"pane_id": "fp:bad", "tab_id": "ft:t9"}, "junk"]}})
            if mode == "empty-pane-id":
                emit({"result": {"panes": [{"pane_id": "", "tab_id": "ft:t1"}]}})
            if mode == "empty-tab-id":
                emit({"result": {"panes": [{"pane_id": "fp:p1", "tab_id": ""}]}})
            if mode == "conflicting-tab":
                moved = [dict(pane) for pane in read_panes()]
                for pane in moved:
                    pane["tab_id"] = "ft:conflict"
                emit({"result": {"panes": moved}})
            emit({"result": {"panes": [{"pane_id": "fp:bad"}]}})
        panes = read_panes()
        result = []
        for pane in panes:
            value = dict(pane)
            for path in sorted((ROOT / "agents").glob("*.json")):
                data = read_agent(path.stem) or {}
                if data.get("pane") == pane["pane_id"]:
                    value["agent"] = data.get("kind", "pi")
                    value["agent_status"] = data.get("status", "idle")
            result.append(value)
        emit({"result": {"panes": result}})
    if len(argv) < 2 or argv[0] != "agent":
        fail("unsupported")
    sub = argv[1]
    if sub == "list":
        malformed = ROOT / "agent_list_malformed"
        if malformed.is_file():
            mode = malformed.read_text(encoding="utf-8").strip() or "missing-tab"
            if mode == "result-not-object":
                emit({"result": "not-an-object"})
            if mode == "empty-pane-id":
                emit({"result": {"agents": [{"name": "x", "pane_id": "", "tab_id": "ft:t1"}]}})
            if mode == "empty-tab-id":
                emit({"result": {"agents": [{"name": "x", "pane_id": "fp:p1", "tab_id": ""}]}})
            emit({"result": {"agents": [{"name": "x", "pane_id": "fp:p1"}]}})
        agents = []
        forced = (ROOT / "agent_list_working")
        forced_names = forced.read_text(encoding="utf-8").split() if forced.is_file() else []
        for path in sorted((ROOT / "agents").glob("*.json")):
            data = read_agent(path.stem)
            if data is not None:
                value = as_agent(path.stem, data)
                if path.stem in forced_names:
                    value["agent_status"] = "working"
                agents.append(value)
        emit({"result": {"agents": agents}})
    if len(argv) < 3:
        fail("bad_usage")
    name = argv[2]
    data = read_agent(name)
    if sub == "get":
        if data is None:
            fail("agent_not_found")
        unreadable = ROOT / "agent_get_error"
        if unreadable.is_file() and name in unreadable.read_text(encoding="utf-8").split():
            fail("socket_unavailable", "simulated transient agent query failure")
        missing = ROOT / "agent_get_missing"
        if missing.is_file() and name in missing.read_text(encoding="utf-8").split():
            fail("agent_not_found")
        emit({"result": {"agent": as_agent(name, data)}})
    if sub == "start":
        if data is not None:
            fail("agent_exists")
        counter = ROOT / "start_count"
        number = int(counter.read_text()) + 1 if counter.is_file() else 1
        counter.write_text(str(number))
        hard = ROOT / "start_hard_fail_at"
        if hard.is_file() and int(hard.read_text()) == number:
            fail("agent_start_failed", "simulated permanent start failure")
        failures = ROOT / "start_failures"
        remaining = int(failures.read_text()) if failures.is_file() else 0
        if remaining > 0:
            failures.write_text(str(remaining - 1))
            fail("agent_pane_busy")
        kind = argv[argv.index("--kind") + 1]
        pane = argv[argv.index("--pane") + 1]
        tab = ""
        for entry in read_panes():
            if entry.get("pane_id") == pane:
                tab = entry.get("tab_id", "")
        separator = argv.index("--") if "--" in argv else len(argv)
        data = {
            "status": "idle",
            "kind": kind,
            "pane": pane,
            "tab": tab,
            "agent_args": argv[separator + 1:],
            "prompt_count": 0,
        }
        if kind == "pi":
            data["session"] = f"fake-session-{name}"
        write_agent(name, data)
        emit({"result": {"agent": as_agent(name, data)}})
    if sub == "prompt":
        if data is None:
            fail("agent_not_found")
        if data.get("status") == "blocked":
            fail("agent_blocked")
        text = argv[3] if len(argv) > 3 else ""
        count = int(data.get("prompt_count", 0)) + 1
        prompt_file = ROOT / "agents" / f"{name}.prompt.{count}.txt"
        data["prompt_count"] = count
        drops = ROOT / "drop_prompts"
        remaining = int(drops.read_text()) if drops.is_file() else 0
        if remaining > 0:
            drops.write_text(str(remaining - 1))
            write_agent(name, data)
            prompt_file.write_text(text, encoding="utf-8")
            emit({"result": {"agent": as_agent(name, data), "type": "agent_prompted"}})
        data["status"] = "working"
        if data.get("kind") == "opencode" and not data.get("session"):
            data["session"] = f"fake-session-{name}"
        processed = int(data.get("processed_prompt_count", 0)) + 1
        data["processed_prompt_count"] = processed
        write_agent(name, data)
        # The prompt file appears only after the status is durable, so a
        # scenario that reacts to the file sees a running turn it can abort.
        prompt_file.write_text(text, encoding="utf-8")
        if processed == 1 and os.environ.get("HI_FAKE_SCENARIO"):
            # Preserve scenario crashes instead of turning them into opaque
            # wait_state timeouts, especially under parallel test execution.
            with (ROOT / "agents" / f"{name}.scenario.log").open("ab") as log:
                subprocess.Popen(
                    [sys.executable, os.environ["HI_FAKE_SCENARIO"], name, str(prompt_file)],
                    stdout=log,
                    stderr=log,
                    start_new_session=True,
                )
        marker = ROOT / "prompt_uncertain"
        if marker.is_file():
            marker.unlink()
            fail("agent_prompt_timeout", "simulated transient prompt failure")
        emit({"result": {"agent": as_agent(name, data), "type": "agent_prompted"}})
    if sub == "read":
        transcript = ROOT / "agents" / f"{name}.transcript"
        sys.stdout.write(transcript.read_text(encoding="utf-8") if transcript.is_file() else "")
        sys.exit(0)
    if sub == "send-keys":
        if data is None:
            fail("agent_not_found")
        keys = argv[3:]
        if "ctrl+c" in keys:
            panes = read_panes()
            pane_cwd = ""
            pane_tab = ""
            for pane in panes:
                if pane.get("pane_id") == data.get("pane"):
                    pane_cwd = pane.get("cwd", "")
                    pane_tab = pane.get("tab_id", "")
            if (ROOT / "release_race_foreign").is_file():
                panes.append(
                    {
                        "pane_id": f"fp:race{len(panes)}",
                        "tab_id": pane_tab,
                        "cwd": pane_cwd,
                    }
                )
                write_panes(panes)
            if (ROOT / "release_race_dirty").is_file() and pane_cwd:
                Path(pane_cwd, "late-write.txt").write_text("written during exit\n", encoding="utf-8")
            agent_file(name).unlink(missing_ok=True)
            emit({"result": {"agent": None, "exited": True}})
        if "escape" in keys:
            data["status"] = "idle"
            write_agent(name, data)
        emit({"result": {"agent": as_agent(name, data)}})
    fail("unsupported")


if __name__ == "__main__":
    main(sys.argv[1:])
