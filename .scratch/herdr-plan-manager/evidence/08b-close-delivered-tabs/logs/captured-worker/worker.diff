+    def agent_fact(self, name: str) -> dict[str, Any]:
+        """Strict lookup: only an explicit agent_not_found proves the agent exited."""
+        proc = run(["herdr", "agent", "get", name], timeout=30)
+        if proc.returncode == 0:
